# FitFuel bilancia sul server: la sentinella che fa le pesate chieste dal telefono (vedi sentinella_linux.py).
# Si installa e si aggiorna con desktop/installa_labpc.sh, che la mette in /etc/systemd/system.
# Riparte da sola se esce (Restart=always, senza arrendersi mai: StartLimitIntervalSec=0) e anche se si blocca: se per
# tre minuti non dice a systemd che e' viva (WatchdogSec), systemd la chiude e la riapre.
[Unit]
Description=FitFuel bilancia (pesate dal telefono via Bluetooth)
After=bluetooth.service network-online.target
Wants=bluetooth.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=fitbilancia
Group=fitbilancia
SupplementaryGroups=bluetooth
Environment=TZ=Europe/Rome PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/fit-bilancia/venv/bin/python /opt/fit-bilancia/sentinella_linux.py
Restart=always
RestartSec=5
# 2 = manca la configurazione: riprovare non servirebbe
RestartPreventExitStatus=2
WatchdogSec=180
# bloccata non si chiude da sola: dopo il segnale del watchdog si aspettano 20 secondi, non 90, prima di SIGKILL
TimeoutStopSec=20
StateDirectory=fit-bilancia
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
