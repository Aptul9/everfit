{
	http_port 8080
	https_port 8443
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

(tls_acme) {
	# Port 80 belongs to another Caddy on the host: certificates come through TLS-ALPN behind sslh.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
}

(tls_internal) {
	tls internal
}

(app) {
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}
}

{$DOMAIN:fit.everbright.it} {
	import tls_{$FIT_TLS:acme}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}
	# The application refuses bodies over 2 MiB.
	request_body {
		max_size 3MB
	}
	handle /.well-known/assetlinks.json {
		root * /srv/public
		header Content-Type application/json
		header Cache-Control no-cache
		file_server
	}
	# Secret path of the PC app and of the scale bridge: the only route where the admin header is set.
	handle_path /{$FIT_PERCORSO}/* {
		request_header X-Fit-Accesso ok
		import app
	}
	handle {
		request_header -X-Fit-Accesso
		import app
	}
}
