{
	# Host network (the app needs Meridian on the host loopback): bind loopback only, sslh owns 443.
	default_bind 127.0.0.1
	http_port 4458
	https_port {$HTTPS_PORT:4450}
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

(tls_acme) {
	# Port 80 belongs to another Caddy on the host: certificates come through TLS-ALPN behind sslh.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
}

(tls_internal) {
	tls internal
}

# Container healthcheck only.
http://127.0.0.1:4459 {
	respond "ok" 200
}

{$DOMAIN:fit.everbright.it} {
	import tls_{$FIT_TLS:acme}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag "noindex, nofollow, noarchive"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://servizi.everbright.it; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:{$APP_PORT:8097} {
		header_up X-Real-IP {remote_host}
		# the coach streams its answer
		flush_interval -1
	}
}
